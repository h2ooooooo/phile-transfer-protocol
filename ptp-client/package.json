{
  "name": "@jalsoedesign/phile-transfer-protocol-client",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "axios-mock-adapter": "^2.1.0",
    "basic-ftp": "^6.2.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "dev:localhost": "npm run dev -- config/localhost.yaml",
    "dev:jalsoedesign": "npm run dev -- config/jalsoedesign.yaml",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "node ../scripts/test.cjs --client",
    "test:unit": "jest --runInBand tests/Config.test.ts tests/CommandExecutor.test.ts tests/RestFileSystem.unit.test.ts tests/APIWritableStream.test.ts tests/AtomicUploads.test.ts tests/DependencyCompatibility.test.ts tests/EncryptedTransport.test.ts tests/FtpLogger.test.ts tests/ServerUtils.test.ts tests/FtpPeerSecurity.test.ts tests/FtpFileSystemAdapter.test.ts tests/FtpControlInput.test.ts",
    "test:startup": "npm run build && node ../scripts/test-client-startup.cjs",
    "test:silent": "jest --silent",
    "test:watch": "jest --watch",
    "prepack": "npm run build"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ],
    "maxWorkers": 1,
    "testTimeout": 30000,
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/tmp/"
    ]
  },
  "dependencies": {
    "axios": "^1.21.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "@electerm/ftp-srv": "^1.1.0"
  },
  "overrides": {
    "deepmerge": "npm:@stackline/deepmerge@1.1.2",
    "glob@>=9": "^14.0.4",
    "minimatch@>=7": "^11.0.5"
  },
  "version": "0.3.0",
  "description": "PTP local FTP bridge for standalone PHP endpoints and the WordPress plugin.",
  "license": "MIT",
  "homepage": "https://h2ooooooo.github.io/phile-transfer-protocol",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "ptp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/src/",
    "dist/package.json",
    "examples/site.yaml",
    "LICENSE",
    "README.md"
  ],
  "bundleDependencies": [
    "axios",
    "winston",
    "yaml",
    "@electerm/ftp-srv"
  ],
  "publishConfig": {
    "access": "public"
  }
}
