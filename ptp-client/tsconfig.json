{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "target": "es2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "node",
      "jest"
    ],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "src/@types"
    ]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
