# Required: use private credentials and an existing absolute directory.
PTP_USERNAME=
PTP_PASSWORD=
PTP_ROOT_PATH=

# Optional: existing parent, outside API and web roots. Empty disables file logging.
PTP_LOG_PATH=
PTP_LOG_OUTPUT_CONSOLE=false
PTP_LOG_HEADERS=false
# Logs body byte counts only, never contents.
PTP_LOG_BODY=false
